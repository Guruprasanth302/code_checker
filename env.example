# ── LLM API Configuration ─────────────────────────────────────────────────────
# Your custom model endpoint (OpenAI-compatible format supported out of the box)
LLM_API_ENDPOINT=https://your-endpoint.example.com/v1/chat/completions

# Your API key / secret token
LLM_API_KEY=your_api_key_here

# The exact model name your endpoint expects
LLM_MODEL_NAME=your-model-name

# Optional: request timeout in seconds (default: 60)
REQUEST_TIMEOUT=60
